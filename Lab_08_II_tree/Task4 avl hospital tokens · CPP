// Lab 08 - Task 4: Hospital Appointment System (AVL Tree)
#include <iostream>
#include <string>
using namespace std;

class Node {
public:
    int token;
    int height;
    Node* left;
    Node* right;

    Node(int t) {
        token = t;
        height = 1;          // a new node is a leaf, so its height is 1
        left = NULL;
        right = NULL;
    }
};

int getHeight(Node* n) {
    return (n == NULL) ? 0 : n->height;
}

int max(int a, int b) {
    return (a > b) ? a : b;
}

void updateHeight(Node* n) {
    n->height = 1 + max(getHeight(n->left), getHeight(n->right));
}

// Balance factor = height(left) - height(right)
int getBalance(Node* n) {
    return (n == NULL) ? 0 : getHeight(n->left) - getHeight(n->right);
}

// Right Rotation (fixes the Left-Left case)
Node* rightRotate(Node* y) {
    Node* x = y->left;
    Node* t2 = x->right;

    x->right = y;
    y->left = t2;

    updateHeight(y);
    updateHeight(x);

    cout << "   -> Right Rotation on " << y->token << endl;
    return x;
}

// Left Rotation (fixes the Right-Right case)
Node* leftRotate(Node* x) {
    Node* y = x->right;
    Node* t2 = y->left;

    y->left = x;
    x->right = t2;

    updateHeight(x);
    updateHeight(y);

    cout << "   -> Left Rotation on " << x->token << endl;
    return y;
}

Node* insert(Node* node, int token) {
    // Step 1: normal BST insertion
    if (node == NULL) return new Node(token);

    if (token < node->token)
        node->left = insert(node->left, token);
    else if (token > node->token)
        node->right = insert(node->right, token);
    else
        return node;         // duplicate tokens are not allowed

    // Step 2: update height of this node
    updateHeight(node);

    // Step 3: check balance factor
    int balance = getBalance(node);

    // Left-Left (LL) case
    if (balance > 1 && token < node->left->token) {
        cout << "   [LL case at node " << node->token << "]" << endl;
        return rightRotate(node);
    }

    // Right-Right (RR) case
    if (balance < -1 && token > node->right->token) {
        cout << "   [RR case at node " << node->token << "]" << endl;
        return leftRotate(node);
    }

    // Left-Right (LR) case
    if (balance > 1 && token > node->left->token) {
        cout << "   [LR case at node " << node->token << "]" << endl;
        node->left = leftRotate(node->left);
        return rightRotate(node);
    }

    // Right-Left (RL) case
    if (balance < -1 && token < node->right->token) {
        cout << "   [RL case at node " << node->token << "]" << endl;
        node->right = rightRotate(node->right);
        return leftRotate(node);
    }

    return node;
}

void inorder(Node* node) {
    if (node == NULL) return;
    inorder(node->left);
    cout << node->token << "  ";
    inorder(node->right);
}

// Shows every node with its height and balance factor
void displayDetails(Node* node) {
    if (node == NULL) return;
    displayDetails(node->left);
    cout << "Token " << node->token
         << "  | Height = " << node->height
         << "  | Balance Factor = " << getBalance(node) << endl;
    displayDetails(node->right);
}

// Prints the tree sideways: right side on top, left side at the bottom
void printTree(Node* node, int space) {
    if (node == NULL) return;
    space += 8;
    printTree(node->right, space);
    cout << endl;
    for (int i = 8; i < space; i++) cout << " ";
    cout << node->token << endl;
    printTree(node->left, space);
}

int main() {
    Node* root = NULL;
    int tokens[] = {15, 25, 35, 45, 55, 65, 75};
    int n = sizeof(tokens) / sizeof(tokens[0]);

    cout << "===== Hospital Appointment System (AVL Tree) =====" << endl << endl;

    for (int i = 0; i < n; i++) {
        cout << "Inserting token " << tokens[i] << endl;
        root = insert(root, tokens[i]);
    }

    cout << endl << "In-order traversal (sorted tokens): ";
    inorder(root);
    cout << endl << endl;

    cout << "Height and balance factor of each node:" << endl;
    displayDetails(root);

    cout << endl << "Final balanced tree structure (root on the left, sideways):" << endl;
    printTree(root, 0);
    cout << endl;

    // ---- Extra demo: shows the LR and RL cases working ----
    cout << "===== Extra demo: LR and RL rotation cases =====" << endl;

    Node* lr = NULL;
    cout << endl << "LR demo (insert 30, 10, 20):" << endl;
    lr = insert(lr, 30);
    lr = insert(lr, 10);
    lr = insert(lr, 20);
    cout << "In-order: "; inorder(lr); cout << " | Root is now " << lr->token << endl;

    Node* rl = NULL;
    cout << endl << "RL demo (insert 10, 30, 20):" << endl;
    rl = insert(rl, 10);
    rl = insert(rl, 30);
    rl = insert(rl, 20);
    cout << "In-order: "; inorder(rl); cout << " | Root is now " << rl->token << endl;

    return 0;
}
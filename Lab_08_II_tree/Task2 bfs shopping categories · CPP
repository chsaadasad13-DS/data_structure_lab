// Lab 08 - Task 2: Online Shopping Categories (BFS / Level-Order Traversal)
#include <iostream>
#include <string>
#include <queue>
using namespace std;

class Node {
public:
    string category;
    Node* left;
    Node* right;

    Node(string c) {
        category = c;
        left = NULL;
        right = NULL;
    }
};

// Breadth-First Traversal: visit the tree level by level using a queue
void bfs(Node* root) {
    if (root == NULL) return;

    queue<Node*> q;
    q.push(root);

    int level = 0;
    while (!q.empty()) {
        int size = q.size();          // number of nodes on this level
        cout << "Level " << level << " : ";

        for (int i = 0; i < size; i++) {
            Node* current = q.front();
            q.pop();

            cout << current->category << "   ";

            if (current->left  != NULL) q.push(current->left);
            if (current->right != NULL) q.push(current->right);
        }
        cout << endl;
        level++;
    }
}

int main() {
    Node* root = new Node("Shop");

    root->left  = new Node("Electronics");
    root->right = new Node("Clothing");

    root->left->left   = new Node("Mobiles");
    root->left->right  = new Node("Laptops");
    root->right->left  = new Node("Men");
    root->right->right = new Node("Women");

    root->left->left->left = new Node("Accessories");

    cout << "===== Shopping Categories (BFS Order) =====" << endl << endl;
    bfs(root);

    cout << endl << "Full BFS order: ";
    // Same traversal printed on one line
    queue<Node*> q;
    q.push(root);
    while (!q.empty()) {
        Node* cur = q.front();
        q.pop();
        cout << cur->category;
        if (cur->left)  q.push(cur->left);
        if (cur->right) q.push(cur->right);
        if (!q.empty()) cout << " -> ";
    }
    cout << endl;

    return 0;
}